// Copy to Secrets.xcconfig (gitignored) and fill in. Values land in Info.plist
// (CoachWorkerHost / CoachAccessClientID / CoachAccessClientSecret). The Worker
// address is fixed to this host and the Access token is sent to it only, never
// to OpenAI. Release builds need all three; DEBUG may leave them empty and use
// KURN_DEBUG_* environment overrides or a direct OpenAI key.
// Host only, no scheme: xcconfig treats "//" as a comment.
COACH_WORKER_HOST =
COACH_ACCESS_CLIENT_ID =
COACH_ACCESS_CLIENT_SECRET =
